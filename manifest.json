{
  "manifest_version": 3,
  "name": "Synonym Ring",
  "version": "1.0.0",
  "description": "Double-click any word in an editable field to cycle through synonyms in-place.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": ["https://api.datamuse.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
